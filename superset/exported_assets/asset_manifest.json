{
  "source": "EnergyOps verified analytics views",
  "superset_version": "3.0.0",
  "database_name": "EnergyOps verified analytics",
  "datasets": [
    {
      "schema": "analytics",
      "view": "energy_hourly",
      "time_column": "hour_start_local",
      "description": "One observed facility-local hour; additive kWh and kVarh. Power factor is a descriptive mean.",
      "metrics": [
        [
          "usage_kwh",
          "Total usage (kWh)",
          "SUM(total_usage_kwh)",
          ",.2f"
        ],
        [
          "intervals",
          "Observed intervals",
          "SUM(observed_interval_count)",
          ",.0f"
        ],
        [
          "hours",
          "Observed hours",
          "COUNT(*)",
          ",.0f"
        ],
        [
          "coverage_pct",
          "Interval coverage (%)",
          "100.0 * SUM(observed_interval_count) / NULLIF(SUM(expected_interval_count), 0)",
          ",.2f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_daily",
      "time_column": "reading_date",
      "description": "One observed facility-local day; 96 expected intervals. Additive kWh and kVarh.",
      "metrics": [
        [
          "usage_kwh",
          "Daily usage (kWh)",
          "SUM(total_usage_kwh)",
          ",.2f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_daily_by_load_type",
      "time_column": "reading_date",
      "description": "One observed day and source load type; load classes may coexist in a day.",
      "metrics": [
        [
          "usage_kwh",
          "Usage by load type (kWh)",
          "SUM(total_usage_kwh)",
          ",.2f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_hourly_by_load_type",
      "time_column": "hour_start_local",
      "description": "One observed hour and source load type; descriptive mean power factor by class.",
      "metrics": [
        [
          "usage_kwh",
          "Usage by load type (kWh)",
          "SUM(total_usage_kwh)",
          ",.2f"
        ],
        [
          "mean_pf_pct",
          "Descriptive mean lagging PF (%)",
          "AVG(mean_lagging_power_factor_pct)",
          ",.2f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_hour_of_day_profile",
      "time_column": null,
      "description": "48 hour-of-day by weekday/weekend groups; historical full-year profile, not date-filterable.",
      "metrics": [
        [
          "mean_hour_kwh",
          "Mean observed hour (kWh)",
          "AVG(mean_observed_hour_usage_kwh)",
          ",.2f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_load_type_summary",
      "time_column": null,
      "description": "Three historical source load types; full-year summary, not date-filterable.",
      "metrics": [
        [
          "usage_kwh",
          "Usage by load type (kWh)",
          "SUM(total_usage_kwh)",
          ",.2f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_hourly_baseline_eligibility",
      "time_column": "hour_start_local",
      "description": "One observed hour; excluded hours have NULL expected kWh.",
      "metrics": [
        [
          "eligible_hours",
          "Eligible hours",
          "SUM(CASE WHEN eligible THEN 1 ELSE 0 END)",
          ",.0f"
        ],
        [
          "eligibility_pct",
          "Eligibility (%)",
          "100.0 * SUM(CASE WHEN eligible THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0)",
          ",.2f"
        ],
        [
          "excluded_hours",
          "Excluded hours",
          "SUM(CASE WHEN NOT eligible THEN 1 ELSE 0 END)",
          ",.0f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_rule_evaluation",
      "time_column": "hour_start_local",
      "description": "One observed hour; eligible and excluded remain distinct. Rule flags are hourly conditions.",
      "metrics": [
        [
          "observed_kwh",
          "Observed usage (kWh)",
          "SUM(observed_usage_kwh)",
          ",.2f"
        ],
        [
          "expected_kwh",
          "Expected usage (kWh, eligible only)",
          "SUM(expected_usage_kwh)",
          ",.2f"
        ],
        [
          "consumption_positive",
          "Consumption-positive hours",
          "SUM(CASE WHEN consumption_deviation_candidate THEN 1 ELSE 0 END)",
          ",.0f"
        ],
        [
          "pf_positive",
          "Power-factor-positive hours",
          "SUM(CASE WHEN lagging_power_factor_review_candidate THEN 1 ELSE 0 END)",
          ",.0f"
        ],
        [
          "combined",
          "Combined-priority hours",
          "SUM(CASE WHEN combined_priority THEN 1 ELSE 0 END)",
          ",.0f"
        ],
        [
          "mean_pf_pct",
          "Descriptive mean hourly lagging PF (%)",
          "AVG(mean_lagging_power_factor_pct)",
          ",.2f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_candidate_hours",
      "time_column": "hour_start_local",
      "description": "One distinct eligible condition-positive hour, including singletons.",
      "metrics": [
        [
          "distinct_candidate_hours",
          "Distinct candidate hours",
          "COUNT(*)",
          ",.0f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_candidate_incidents",
      "time_column": "start_hour_local",
      "description": "One sustained rule-specific island; an hour can participate in both rule streams.",
      "metrics": [
        [
          "incidents",
          "Sustained candidate incidents",
          "COUNT(*)",
          ",.0f"
        ]
      ]
    },
    {
      "schema": "analytics",
      "view": "energy_rule_summary",
      "time_column": null,
      "description": "Two fixed rule rows for full-year totals; not date-filterable and not an hourly grain.",
      "metrics": []
    }
  ],
