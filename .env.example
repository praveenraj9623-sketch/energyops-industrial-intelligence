# Copy to .env and set a unique local password. Never commit .env.
ENERGYOPS_SOURCE_CSV=
ENERGYOPS_DB_NAME=energyops
ENERGYOPS_DB_USER=energyops_app
ENERGYOPS_DB_PASSWORD=replace-with-a-generated-local-password
ENERGYOPS_DB_HOST=127.0.0.1
ENERGYOPS_DB_PORT=5434
ENERGYOPS_DB_CONTAINER_PORT=5432

# Local Superset 3.0 only. Generate unique values; keep the populated .env ignored.
SUPERSET_PORT=8090
SUPERSET_SECRET_KEY=replace-with-a-random-64-character-secret
SUPERSET_ADMIN_USERNAME=energyops_admin
SUPERSET_ADMIN_PASSWORD=replace-with-a-unique-local-admin-password
SUPERSET_ADMIN_EMAIL=admin@localhost.invalid
SUPERSET_METADATA_PASSWORD=replace-with-a-unique-local-metadata-password
ENERGYOPS_ANALYTICS_USER=energyops_analytics_ro
ENERGYOPS_ANALYTICS_PASSWORD=replace-with-a-unique-local-readonly-password
